{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.govern/**)",
      "Read(./runs/**)",
      "Read(./govern.py)",
      "Read(./.claude/hooks/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(./governance.yaml)",
      "Write(./governance.yaml)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/govern.py\" hook session",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/govern.py\" hook pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/trace.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/govern.py\" hook stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
